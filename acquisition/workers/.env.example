# SRA Snapshot Worker — environment configuration
# (Set these on the Railway WORKER service. The API service is independent.)

# REQUIRED — SRA Firm Data Web Service subscription key (Azure APIM).
SRA_SUBSCRIPTION_KEY=

# OPTIONAL — SRA API gateway base URL. Defaults to the built-in value if unset.
# CONFIRM the exact gateway host + path against the SRA Technical Document.
SRA_BASE_URL=https://sra-prod-apim.azure-api.net

# REQUIRED — directory for Collection Packages. MUST point at the mounted Railway
# Volume so packages survive restarts/redeploys (e.g. the volume mounted at /data).
RUN_ROOT=/data/sra-runs

# OPTIONAL — seconds between polls. Default 3600 (1h). The SRA dataset refreshes
# every 24h, so 3600–21600 is reasonable; respect the per-24h rate cap.
CHECK_INTERVAL=21600

# OPTIONAL — log level: error | warn | info | debug. Default info.
LOG_LEVEL=info

# OPTIONAL — if set, the worker serves operational health JSON on this port.
# Leave unset for a pure background worker (no public domain required).
# HEALTH_PORT=8080
