{
  "dataset_id": "HPR-DATA-003",
  "dataset_version": 3,
  "supersedes": "HPR-DATA-002 (v2.0)",
  "governed_by": "HPR-001 (Foundation Freeze v1.0)",
  "consumed_by": "SOT-CLOUDHOST-001 (Specification Freeze v1.0)",
  "status": "DATASET_FREEZE_v3.0_FROZEN",
  "note": "Hosting/Cloud Provider Attribution Reference - v3 LIMITED residual expansion. Strict superset of v2.0: HCP-001..011,013..016 byte-identical; HCP-012 GoDaddy gains additive ASNs AS398101/AS398787 (same provider; no key removed). Adds 12 head providers HCP-017..028 (cloud + managed-hosting) from HPR-DATA-003-A residual analysis. Head-only: explicitly NOT the singleton tail, NOT AS15169 Google (E3), NOT CDN-origin inference. ASN_EXACT (all RIR/Cymru-verified). Attribution-only; no scoring/ranking/reputation.",
  "backward_compatibility": "Strict superset of v2.0: every v2 ASN/range maps to the same provider_id in v3 (HCP-012 additive-only). v2.json untouched, retained immutable.",
  "cdn_masking_note": "Unchanged from v2.0: cdn_edge providers mask origin -> cloud-hosting-origin concentration a LOWER BOUND; hidden origins never inferred.",
  "freeze": {
    "frozen": true,
    "freeze_date": "2026-06-23",
    "freeze_version": "Dataset Freeze v3.0",
    "release_authority": "Founder / Governance Architect (Founder Dataset Freeze Review 2026-06-23)",
    "documentary_verification": "12 new providers HCP-017..028 + 2 GoDaddy ASNs verified 2026-06-23 via Team Cymru AS-name (RIR org). All ASN_EXACT (no published-range files used in v3; Oracle range file unavailable at fetch, ASN-primary). Head-only per HPR-DATA-003-A; singleton tail excluded by design.",
    "revalidation_at_freeze": "PASS — validate-seed-v3.js all checks (schema, provider_id/ASN uniqueness, version_added in {1,2,3}, no prohibited fields, HCP-001..011/013..016 byte-identical, HCP-012 additive-only, strict superset every-v2-ASN->same-provider, attribution re-checks incl. AS15169->UNMAPPED). 28 providers / 37 ASN keys.",
    "immutability": "Immutable per HPR-001 §8.1 from this freeze. Supersedes v2.0 as the dataset for new runs; v1.0 + v2.0 retained immutable for RUN-CLOUDHOST-001/002 reproducibility. Expansion only via strict-superset successor.",
    "observability_ceiling": "v3.0 materially exhausts high-value reference-data attribution. Projected coverage ~82% (the practical observability ceiling). Residual ~18% is a structural floor: AS15169 Google (E3-excluded, consumer-conflating), the 118-ASN singleton tail (diminishing returns, excluded by design), and CDN-masked origins (constitutionally unobservable; hidden origins never inferred). Further reference expansion past this head yields vanishing returns."
  },
