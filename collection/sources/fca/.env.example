# FCA Observatory Worker — environment configuration
# (Set these on the Railway FCA worker service. The API service and the SRA worker
#  service are independent and unaffected.)

# REQUIRED — FCA Financial Services Register API credentials (free; header auth
# X-Auth-Email + X-Auth-Key). The credential authenticates the observer application
# and is never written into any evidence artefact.
FCA_EMAIL=
FCA_API_KEY=

# OPTIONAL — FCA FS Register API base URL. Defaults to the built-in value if unset.
FCA_BASE_URL=https://register.fca.org.uk/services/V0.1

# REQUIRED — directory for the run-level Collection Package + commit ledger. MUST
# point at the mounted Railway Volume so an in-progress package and its ledger survive
# restarts/redeploys (this is what makes resume + exactly-once hold in production).
RUN_ROOT=/data/fca-runs

# NOTE — collection interval: the FCA worker performs exactly ONE collection cycle and
# exits cleanly (it does NOT poll). Periodic operation is scheduled by Railway via the
# cronSchedule in railway.fca.json, not by an in-process loop. No CHECK_INTERVAL.

# NOTE — health endpoint: the single-cycle worker exposes no HTTP health port. Cycle
# outcome is observable from the process exit code and the on-disk package status
# (collecting | collected | sealed), reports/, and commit-log.ndjson on the volume.
