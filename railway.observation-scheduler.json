{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "node observatory/observation-scheduler/run-drain-cli.js --production --max-states-per-run 1500 --page-size 250 --concurrency 8 --runtime-budget-ms 720000",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "cronSchedule": "*/15 * * * *"
  }
}
