# ── Server ───────────────────────────────────────────────────────────────────
# Railway injects PORT automatically — only set this for local dev
PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Supports single-segment wildcards, e.g. https://soterius-*.vercel.app
ALLOWED_ORIGINS=https://soterius-frontend.vercel.app,https://soterius-*.vercel.app,http://localhost:5173

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL and service role key (Settings → API in Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Email (Resend) ────────────────────────────────────────────────────────────
# API key from resend.com — used to send gate confirmation emails
RESEND_API_KEY=re_your-resend-api-key

# ── Admin ─────────────────────────────────────────────────────────────────────
# Token required for GET /api/gate/submissions.csv
# Set to any strong random string
ADMIN_TOKEN=change-me-to-a-strong-secret

# ── Public backend URL ────────────────────────────────────────────────────────
# Used to build the PDF download link in gate confirmation emails
# (POST /api/scan/submit-gate). If unset, the link is omitted from the email
# (logged as a warning) rather than the request failing.
# Local dev: leave unset. Production: the backend's public Railway URL.
BACKEND_URL=https://your-backend.railway.app

# ── Developer bootstrap (local development only — see CLAUDE.md) ─────────────
# All optional; bootstrap-dev.js falls back to the defaults shown if unset.
# DEV_USER_EMAIL=dev@soterius.local
# DEV_USER_PASSWORD=DevPassword123!
# DEV_CUSTOMER_NAME=Dev Test Organisation

# ── Permanent operations user (real environment — see CLAUDE.md) ─────────────
# Required (no default) when running create-ops-user.js — this creates a
# real, permanent account, unlike the throwaway dev bootstrap above.
# OPS_USER_EMAIL=you@soterius.com
# OPS_USER_PASSWORD=set-a-strong-password

# ── Portfolio authorisation gate (Phase 4A) ───────────────────────────────────
# Enforces requirePortfolio (organisation detail routes) and the Dashboard
# Improvement Queue's portfolio scoping. Defaults to false — there is not yet
# a frontend workflow to populate a customer's portfolio, so enforcing this
# would 403/empty every customer out of data they have no way to add. The
# gating logic itself is fully implemented and tested regardless of this
# value; set to 'true' to enable it once portfolio-management UI exists.
ENABLE_PORTFOLIO_GATE=false

# ── Renewal lookups (Companies House / SRA / Observatory) ────────────────────
# Companies House REST API key — used for live company search/profile lookups.
# Get one free at https://developer.company-information.service.gov.uk.
# Existing signal-lab code also accepts CH_API_KEY as a fallback name.
COMPANIES_HOUSE_API_KEY=your-companies-house-api-key

# Optional. Overrides which sealed SRA snapshot backend/api/services/sraLookup.js
# reads (defaults to the most recently modified run under
# collection/sources/sra/runs/*/raw/snapshot.json). SRA has no live per-firm
# lookup endpoint — only a full-register bulk feed — so lookups are served from
# this local snapshot, refreshed periodically via backend/authority/reacquire-sra.js.
# SRA_SNAPSHOT_PATH=collection/sources/sra/runs/live-004/raw/snapshot.json

# ── Public scan protection (ENG-010 / ENG-013 WP1) ───────────────────────────
# Infrastructure-only ingress controls for the future public scan route
# (ENG-009). Built and tested now; not yet mounted on any route — ENG-009/
# WP2 wires these onto the new public route when it ships. All values below
# are illustrative starting points (ENG-010 §8), not frozen — tune once real
# traffic is observed.

# How many hops of proxy Railway's edge sits in front of this container.
# Required for req.ip to reflect the real client rather than Railway's
# internal forwarding address — every IP-keyed control below depends on this
# being correct. VERIFY against Railway's actual topology before relying on
# these in production (ENG-010 §2.3/§10 open question 2) — do not assume the
# default of 1 is correct for your deployment.
TRUST_PROXY=1

# Per-IP rate limiting (backend/api/middleware/publicScanRateLimit.js)
PUBLIC_SCAN_RATE_WINDOW_MS=3600000
PUBLIC_SCAN_RATE_MAX=30
PUBLIC_SCAN_RATE_SOFT_RATIO=0.7
PUBLIC_SCAN_RATE_SOFT_DELAY_MS=1500

# Per-domain cooldown (backend/api/middleware/publicScanDomainCooldown.js)
PUBLIC_SCAN_DOMAIN_COOLDOWN_MS=21600000

# Global in-flight concurrency ceiling (backend/api/middleware/publicScanConcurrencyGuard.js)
PUBLIC_SCAN_CONCURRENCY_MAX=5
PUBLIC_SCAN_CONCURRENCY_RETRY_AFTER_S=30

# ── Puppeteer / Chrome ───────────────────────────────────────────────────────
# Leave unset in both local dev and Docker — Puppeteer uses its bundled Chrome.
# Only set this if you need to override with a specific Chrome binary path.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
