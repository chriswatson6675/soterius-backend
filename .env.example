# ── Server ───────────────────────────────────────────────────────────────────
# Railway injects PORT automatically — only set this for local dev
PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Supports single-segment wildcards, e.g. https://soterius-*.vercel.app
ALLOWED_ORIGINS=https://soterius-frontend.vercel.app,https://soterius-*.vercel.app,http://localhost:5173

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Use a Gmail App Password (not your regular password):
# Google Account → Security → 2-Step Verification → App passwords
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# ── Admin ─────────────────────────────────────────────────────────────────────
# Token required for GET /api/gate/submissions.csv
# Set to any strong random string
ADMIN_TOKEN=change-me-to-a-strong-secret

# ── Puppeteer / Chrome ───────────────────────────────────────────────────────
# Set by Dockerfile in production; leave unset locally (puppeteer uses bundled Chrome)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
